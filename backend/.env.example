# Server
APP_PORT=3000
APP_HOST=127.0.0.1
NODE_ENV=production

# Database
DATABASE_PATH=./data/app.db

# Secrets - GENERATE YOUR OWN RANDOM VALUES, DO NOT REUSE THESE
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

# Workspace
WORKSPACE_DIR=./workspaces

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Limits
MAX_CONCURRENT_WORKERS=2
DEFAULT_COMMAND_TIMEOUT_MS=120000
DEFAULT_TASK_TIMEOUT_MS=600000
MAX_RETRIES=3
APPROVAL_TIMEOUT_MS=600000
MAX_TOOL_ITERATIONS_PER_TASK=8

# Initial admin user (only used on first run / empty users table)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Container / PaaS (Koyeb) options
# PORT=8000                 (used if APP_PORT is unset)
# APP_HOST=0.0.0.0          (must be 0.0.0.0 inside a container)
# TRUST_PROXY_HOPS=1        (number of reverse proxies in front of the app)
# COOKIE_SECURE=false       (only for testing over plain http; leave unset behind HTTPS)
