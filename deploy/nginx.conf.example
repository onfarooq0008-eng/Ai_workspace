# Example reverse proxy config for the AI Agent Platform.
# Copy to /etc/nginx/sites-available/ai-agent, edit server_name, then:
#   sudo ln -s /etc/nginx/sites-available/ai-agent /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Then obtain HTTPS with: sudo certbot --nginx -d your-domain.example.com

server {
    listen 80;
    server_name your-domain.example.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE streaming needs buffering off
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
